# 数据库密码
DB_PASSWORD=your_db_password

# JWT 密钥（至少32字符）
JWT_SECRET=your_jwt_secret_at_least_32_characters

# 百度千帆 API Key
QIANFAN_API_KEY=your_qianfan_api_key

# 邮件服务（QQ邮箱 SMTP）
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_authorization_code

# 管理员默认账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
ADMIN_EMAIL=your_admin_email@example.com

# AES 加密密钥（16位，用于 API Key 加解密）
ENCRYPTION_KEY=your_16_char_key

# Tavily 搜索 API Key
TAVILY_API_KEY=your_tavily_api_key

# 图片识别模型 API Key
IMAGE_API_KEY=your_image_api_key

# 雨云 S3 兼容存储
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_URL_PREFIX=https://your-bucket.example.com

# 硅基流动 API Key（嵌入模型 BAAI/bge-large-zh-v1.5）
SILICONFLOW_API_KEY=your_siliconflow_api_key

# 记忆提取 LLM API Key（DeepSeek）
MEMORY_LLM_API_KEY=your_memory_llm_api_key

# CORS 允许来源（逗号分隔多个地址）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

